{
  "name": "@paulrevival/ai-wincon-bar",
  "version": "0.1.0",
  "description": "Context window usage bar for Claude Code status line",
  "type": "module",
  "bin": {
    "ai-wincon-bar": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
